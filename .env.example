# Copiar a .env y completar (el archivo .env no se sube a git)

# Google Cloud Vision — OCR de facturas en ingreso de bodega
GOOGLE_VISION_CREDENTIALS=data/google_service_account.json

# Cloudinary — imágenes de productos en la nube
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Usuario SuperAdmin inicial (solo si no hay ningún SuperAdmin en la BD)
ANDES_ADMIN_USERNAME=admin
ANDES_ADMIN_PASSWORD=
ANDES_ADMIN_EMAIL=admin@andesautoparts.cl

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=tu_cuenta@gmail.com
MAIL_PASSWORD=contraseña_de_aplicacion_gmail
MAIL_FROM=tu_cuenta@gmail.com

# SII Sync — consulta DTE emitidos vía API intermediaria (no emisión desde ERP)
SII_API_PROVIDER=baseapi
SII_API_KEY=
SII_RUT_EMPRESA=
SII_RUT=
SII_PASSWORD=
SII_AMBIENTE=certificacion

# Google Drive — backup automático de base de datos
GDRIVE_OAUTH_CREDENTIALS=
GDRIVE_TOKEN_PATH=
GDRIVE_FOLDER_ID=1XxoL6h2lpQ26_-RXiqe1hWVamOtz3JHD
BACKUP_RETENTION_DAYS=

# Sync unidireccional PC → Render (app móvil). Mismo token en .env local y en Render.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
ANDES_DB_SYNC_TOKEN=
ANDES_RENDER_SYNC_URL=https://andes-auto-parts.onrender.com/admin/backups/sync

# Andes Assistant NL (FASE 3) — LLM planner lives in ERP only. Default OFF / FakePlanner.
# Soft-enable ONLY when ALL of: NL=1, ORCH_PLANNER=llm, API key set, ANDES_ENV=local|staging.
# Production / unset ANDES_ENV never soft-enables. Kill switch: ANDES_ASSISTANT_NL_ENABLED=0
ANDES_ENV=local
ANDES_ASSISTANT_NL_ENABLED=0
ANDES_ORCH_PLANNER=fake
ANDES_LLM_PROVIDER=openai_compatible
ANDES_LLM_API_KEY=
ANDES_LLM_BASE_URL=https://api.openai.com/v1
ANDES_LLM_PLANNER_MODEL=gpt-4.1-mini
ANDES_LLM_TIMEOUT_SECONDS=20
ANDES_LLM_MAX_RETRIES=2
ANDES_LLM_MAX_OUTPUT_TOKENS=800
ANDES_LLM_TEMPERATURE=0

# Agent Gateway (READ-ONLY tools). Never put the service token in the browser or LLM prompts.
ANDES_AGENT_URL=http://127.0.0.1:5055
ANDES_AGENT_HOST=127.0.0.1
ANDES_AGENT_PORT=5055
ANDES_AGENT_SERVICE_TOKEN=
ANDES_ERP_BASE_URL=http://127.0.0.1:5000
ANDES_AGENT_RATE_LIMIT_MAX=60
ANDES_AGENT_RATE_LIMIT_WINDOW=60
ANDES_ORCH_AUDIT_PATH=data/orchestrator_audit.jsonl
# Assistant metrics (FASE 6) — hashes/aggregates only; never prompts or PII
ANDES_ASSISTANT_METRICS_PATH=data/assistant_metrics.jsonl
# Optional USD cost estimate when the LLM provider returns usage tokens
ANDES_LLM_COST_INPUT_PER_1K=
ANDES_LLM_COST_OUTPUT_PER_1K=
# FASE 7A — persistent conversation history (default OFF; TurnStore RAM unchanged)
ANDES_ASSISTANT_HISTORY_ENABLED=0
ANDES_ASSISTANT_HISTORY_RETENTION_DAYS=90
ANDES_ASSISTANT_HISTORY_SOFT_DELETE_GRACE_DAYS=7
ANDES_ASSISTANT_STORE_MESSAGE_EXCERPT=0
# Optional override (default: data/andes.db)
# ANDES_ASSISTANT_HISTORY_DB=
# FASE 7B.1 — controlled memory storage (default OFF; no planner integration yet)
ANDES_ASSISTANT_MEMORY_ENABLED=0
# Optional override. MUST be the same SQLite file as ANDES_ASSISTANT_HISTORY_DB
# (or omit both → data/andes.db). Split files are NOT supported: conversation-scoped
# pins cannot verify ownership (error_code=memory_history_db_mismatch).
# ANDES_ASSISTANT_MEMORY_DB=
# FASE 7B.5 — derived memory (frequent_entity / conversation_summary); default OFF
ANDES_ASSISTANT_MEMORY_DERIVED=0
ANDES_ASSISTANT_MEMORY_EXPLICIT=0
ANDES_ASSISTANT_MEMORY_MAX_PER_USER=50
ANDES_ASSISTANT_MEMORY_MAX_PER_CONVERSATION=10
ANDES_ASSISTANT_MEMORY_SOFT_DELETE_GRACE_DAYS=7
# FASE 7B.2 — selector budget (hints to planner; still requires MEMORY_ENABLED=1)
ANDES_ASSISTANT_MEMORY_SELECTOR_MAX_SLOTS=12
ANDES_ASSISTANT_MEMORY_SELECTOR_MAX_CHARS=800
# FASE 8.1 — evidence-aware AgentLoop (default OFF). Requires NL=1, ORCH=llm, soft-enable.
# If AGENT=1 but soft-enable is invalid, the current planner→composer path is used.
ANDES_ASSISTANT_AGENT_ENABLED=0
# FASE 8.2 — claim provenance. Default OFF (observation mode): the violation is
# counted and reported, the claim is still published. With 1 a claim whose
# figures do not come from the evidence it cites is DROPPED.
# Measured on the 66-case benchmark with a real LLM: 53/53 applicable cases
# clean, 0 violations, 0 published claims at risk — so turning it on changes no
# current answer and only guards against future mis-citation. Left at 0 so the
# rollback is an env change, not a deploy.
ANDES_ASSISTANT_PROVENANCE_ENFORCE=0
# Per-1k token rates. While BOTH are empty, cost_est is None on every turn and
# MAX_COST_PER_TURN never evaluates: the active guard is TOKEN_BUDGET_FALLBACK,
# an 8000-token proxy for a cost ceiling nobody priced. Setting either one makes
# the declared cost limit real and the per-turn cost observable in the audit.
# Chat NL rate limit (requests per user per minute). 0 disables.
ANDES_ASSISTANT_CHAT_RATE_LIMIT=10
