# Copiar a .env y completar (el archivo .env no se sube a git)

# Google Cloud Vision — OCR de facturas en ingreso de bodega
GOOGLE_VISION_CREDENTIALS=data/google_service_account.json

# Cloudinary — imágenes de productos en la nube
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Usuario SuperAdmin inicial (solo si no hay ningún SuperAdmin en la BD)
ANDES_ADMIN_USERNAME=admin
ANDES_ADMIN_PASSWORD=
ANDES_ADMIN_EMAIL=admin@andesautoparts.cl

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=tu_cuenta@gmail.com
MAIL_PASSWORD=contraseña_de_aplicacion_gmail
MAIL_FROM=tu_cuenta@gmail.com

# SII Sync — consulta DTE emitidos vía API intermediaria (no emisión desde ERP)
SII_API_PROVIDER=baseapi
SII_API_KEY=
SII_RUT_EMPRESA=
SII_RUT=
SII_PASSWORD=
SII_AMBIENTE=certificacion

# Google Drive — backup automático de base de datos
GDRIVE_OAUTH_CREDENTIALS=
GDRIVE_TOKEN_PATH=
GDRIVE_FOLDER_ID=1XxoL6h2lpQ26_-RXiqe1hWVamOtz3JHD
BACKUP_RETENTION_DAYS=

# Sync unidireccional PC → Render (app móvil). Mismo token en .env local y en Render.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
ANDES_DB_SYNC_TOKEN=
ANDES_RENDER_SYNC_URL=https://andes-auto-parts.onrender.com/admin/backups/sync

# Andes Assistant NL (FASE 3) — LLM planner lives in ERP only. Default OFF / FakePlanner.
# Soft-enable ONLY when ALL of: NL=1, ORCH_PLANNER=llm, API key set, ANDES_ENV=local|staging.
# Production / unset ANDES_ENV never soft-enables. Kill switch: ANDES_ASSISTANT_NL_ENABLED=0
ANDES_ENV=local
ANDES_ASSISTANT_NL_ENABLED=0
ANDES_ORCH_PLANNER=fake
ANDES_LLM_PROVIDER=openai_compatible
ANDES_LLM_API_KEY=
ANDES_LLM_BASE_URL=https://api.openai.com/v1
ANDES_LLM_PLANNER_MODEL=gpt-4.1-mini
ANDES_LLM_TIMEOUT_SECONDS=20
ANDES_LLM_MAX_RETRIES=2
ANDES_LLM_MAX_OUTPUT_TOKENS=800
ANDES_LLM_TEMPERATURE=0

# Agent Gateway (READ-ONLY tools). Never put the service token in the browser or LLM prompts.
ANDES_AGENT_URL=http://127.0.0.1:5055
ANDES_AGENT_HOST=127.0.0.1
ANDES_AGENT_PORT=5055
ANDES_AGENT_SERVICE_TOKEN=
ANDES_ERP_BASE_URL=http://127.0.0.1:5000
ANDES_AGENT_RATE_LIMIT_MAX=60
ANDES_AGENT_RATE_LIMIT_WINDOW=60
ANDES_ORCH_AUDIT_PATH=data/orchestrator_audit.jsonl
# Chat NL rate limit (requests per user per minute). 0 disables.
ANDES_ASSISTANT_CHAT_RATE_LIMIT=10
